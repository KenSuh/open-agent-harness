      "resolve": {
        "argv": [
          "fake/bin/claude"
        ],
        "kind": "native",
        "source": "fake/bin/claude"
      },
      "runs": {
        "--version": {
          "returncode": 0,
          "stderr": "",
          "stdout": "2.1.318 (Claude Code)\n",
          "timed_out": false
        },
        "auth status": {
          "returncode": 0,
          "stderr": "",
          "stdout": "{\"loggedIn\": false}\n",
          "timed_out": false
        }
      },
      "timeout": 10.0,
