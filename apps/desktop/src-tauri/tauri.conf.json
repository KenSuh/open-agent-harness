{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAH",
  "mainBinaryName": "oah-desktop",
  "identifier": "dev.oah.desktop",
  "build": {
    "beforeDevCommand": "node scripts/stage-cli.mjs && npm --prefix ui run dev",
    "beforeBuildCommand": "node scripts/stage-cli.mjs && npm --prefix ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OAH",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1NTEzMTEzNzAzRDZDOTAKUldTUWJEMXdFekZSNVkxQ0VkeVU3QXFWUXRiT1l4MEMxQmVlKzR6a0ZvMzFTeFBZUExlVnEvUjkK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/KenSuh/open-agent-harness/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/oah", "binaries/oah-project-tools"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
