      "license": "MIT",
      "steps": [
        {
          "manual": "/plugin install superpowers@claude-plugins-official"
        }
      ],
      "reason": "Two files in its skills (a token variable assignment and an absolute home folder path) fail this kit's privacy scan unchanged, so it is linked.",
      "purpose": "Core process skills: brainstorming, TDD, debugging, plans and code review."
    },
