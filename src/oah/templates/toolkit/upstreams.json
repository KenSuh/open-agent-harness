    {
      "name": "unlazy",
      "kind": "skill",
      "source": "https://github.com/Leonxlnx/unlazy",
      "version": "2.1.0 (16671491f667)",
      "license": "MIT",
      "steps": [
        {
          "manual": "oah init --with-unlazy installs unlazy at the commit and scripts digest that lane P5 contract-tests (available once P5 lands); upstream: https://github.com/Leonxlnx/unlazy"
        }
      ],
      "reason": "unlazy is the gates' operational dependency: it is installed only at P5's contract-tested pin and never updated automatically. A test file in its repository also holds an absolute home folder path, which this kit's privacy scan refuses, and vendored files are never edited.",
      "purpose": "Completion discipline: acceptance gates, the depth tree and evidence before reporting."
    },
